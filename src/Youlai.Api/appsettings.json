{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "server=www.youlai.tech;port=3306;database=youlai_admin;user=youlai;password=123456;CharSet=utf8mb4;"
  },
  "Redis": {
    "ConnectionString": "www.youlai.tech:6379,password=123456,defaultDatabase=1"
  },
  "Security": {
    "Session": {
      "AccessTokenTimeToLive": 7200,
      "RefreshTokenTimeToLive": 604800,
      "Jwt": {
        "SecretKey": "SecretKey012345678901234567890123456789012345678901234567890123456789"
      }
    }
  },
  "Ai": {
    "Enabled": false,
    "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "ApiKey": "",
    "Model": "qwen-plus"
  },
  "Codegen": {
    "CreateMenu": true
  },
  "Captcha": {
    "Width": 120,
    "Height": 40,
    "Length": 4,
    "InterfereCount": 2,
    "ExpireSeconds": 120,
    "FontName": "Arial",
    "FontSize": 22
  },
  "FileStorage": {
    "Type": "s3",
    "Upload": {
      "MaxFileSizeMb": 50,
      "AllowedExtensions": "jpg,jpeg,png,gif"
    },
    "Local": {
      "StoragePath": "uploads",
      "PublicBaseUrl": "http://localhost:8000"
    },
    "S3": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "rustfs-admin",
      "SecretKey": "rustfs-admin",
      "BucketName": "public",
      "CustomDomain": ""
    },
    "Aliyun": {
      "Endpoint": "oss-cn-hangzhou.aliyuncs.com",
      "AccessKeyId": "YOUR_ACCESS_KEY_ID",
      "AccessKeySecret": "YOUR_ACCESS_KEY_SECRET",
      "BucketName": "youlai"
    }
  },
  "WechatMiniapp": {
    "AppId": "Your_AppId",
    "AppSecret": "Your_AppSecret"
  },
  "RateLimit": {
    "DefaultLimit": 60,
    "DefaultWindow": "00:01:00",
    "Ip": {
      "Enabled": true,
      "Limit": 1000,
      "Window": "00:01:00"
    }
  },
  "AllowedHosts": "*"
}
