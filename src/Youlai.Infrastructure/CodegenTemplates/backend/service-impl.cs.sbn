using Youlai.Application.Exceptions;
using Youlai.Application.Extensions;
using Youlai.Application.Persistence;
using Youlai.Application.Results;
{{~ if hasCreateBy || hasUpdateBy ~}}
using Youlai.Application.Security;
{{~ end ~}}
using Youlai.Application.{{ moduleNamePascal }}.Dtos;
using Youlai.Application.{{ moduleNamePascal }}.Interfaces;
using Youlai.Domain.Entities;

namespace Youlai.Application.{{ moduleNamePascal }}.Services;

/// <summary>
/// {{ businessName }}服务
/// </summary>
/// <remarks>
/// 提供{{ businessName }}的查询与维护能力
/// </remarks>
internal sealed class {{ entityName }}Service : I{{ entityName }}Service
{
    private readonly IReadOnlyDbContext _readDb;
    private readonly IRepository<{{ entityName }}> _repository;
    private readonly IUnitOfWork _unitOfWork;
{{~ if hasCreateBy || hasUpdateBy ~}}
    private readonly ICurrentUser _currentUser;
{{~ end ~}}

    public {{ entityName }}Service(
        IReadOnlyDbContext readDb,
        IRepository<{{ entityName }}> repository,
        IUnitOfWork unitOfWork{{ if hasCreateBy || hasUpdateBy }},
        ICurrentUser currentUser{{ end }})
    {
        _readDb = readDb;
        _repository = repository;
        _unitOfWork = unitOfWork;
{{~ if hasCreateBy || hasUpdateBy ~}}
        _currentUser = currentUser;
{{~ end ~}}
    }

    /// <summary>
    /// {{ businessName }}分页
    /// </summary>
    public async Task<PageResult<{{ entityName }}PageVo>> GetPageAsync({{ entityName }}Query query, CancellationToken cancellationToken = default)
    {
        var (pageNum, pageSize) = query.Normalize();

        var q = _readDb.Query<{{ entityName }}>();
{{~ if hasIsDeleted ~}}
        q = q.Where(x => {{ if isDeletedType == "bool" }}x.IsDeleted == false{{ else }}x.IsDeleted == 0{{ end }});
{{~ end ~}}
{{~ for field in fieldConfigs ~}}
{{~ if field.IsShowInQuery == 1 ~}}
{{~ if field.FormType == "DATE" || field.FormType == "DATE_TIME" ~}}
{{~ if field.QueryType == "BETWEEN" ~}}
        if (query.{{ field.PropertyName }} is { Length: 2 })
        {
            var startOk = DateTime.TryParse(query.{{ field.PropertyName }}[0], out var start);
            var endOk = DateTime.TryParse(query.{{ field.PropertyName }}[1], out var end);
            if (startOk && endOk)
            {
                q = q.Where(x => x.{{ field.PropertyName }} >= start && x.{{ field.PropertyName }} <= end);
            }
        }
{{~ else ~}}
        if (!string.IsNullOrWhiteSpace(query.{{ field.PropertyName }}))
        {
            var value = query.{{ field.PropertyName }}!.Trim();
            if (DateTime.TryParse(value, out var dateValue))
            {
                q = q.Where(x => x.{{ field.PropertyName }} == dateValue);
            }
        }
{{~ end ~}}
{{~ else ~}}
{{~ if field.QueryType == "LIKE" && field.CsType == "string" ~}}
        if (!string.IsNullOrWhiteSpace(query.{{ field.PropertyName }}))
        {
            var keyword = query.{{ field.PropertyName }}!.Trim();
            q = q.Where(x => x.{{ field.PropertyName }} != null && x.{{ field.PropertyName }}.Contains(keyword));
        }
{{~ else if field.QueryType == "IN" && field.CsType == "string" ~}}
        if (!string.IsNullOrWhiteSpace(query.{{ field.PropertyName }}))
        {
            var values = query.{{ field.PropertyName }}!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            q = q.Where(x => values.Contains(x.{{ field.PropertyName }}!));
        }
{{~ else ~}}
{{~ if field.CsType == "string" ~}}
        if (!string.IsNullOrWhiteSpace(query.{{ field.PropertyName }}))
        {
            var keyword = query.{{ field.PropertyName }}!.Trim();
            q = q.Where(x => x.{{ field.PropertyName }} == keyword);
        }
{{~ else ~}}
        if (query.{{ field.PropertyName }} != null)
        {
            q = q.Where(x => x.{{ field.PropertyName }} == query.{{ field.PropertyName }});
        }
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}

{{~ if hasUpdateTime ~}}
{{~ if hasCreateTime ~}}
        q = q.OrderByDescending(x => x.UpdateTime ?? x.CreateTime);
{{~ else ~}}
        q = q.OrderByDescending(x => x.UpdateTime);
{{~ end ~}}
{{~ else if hasCreateTime ~}}
        q = q.OrderByDescending(x => x.CreateTime);
{{~ else if hasId ~}}
        q = q.OrderByDescending(x => x.Id);
{{~ end ~}}

        return await _readDb.PageAsync(
            q.Select(x => new {{ entityName }}PageVo
            {
{{~ if hasId ~}}
                Id = x.Id,
{{~ end ~}}
{{~ for field in fieldConfigs ~}}
{{~ if field.IsShowInList == 1 && field.FieldName != "id" ~}}
                {{ field.PropertyName }} = x.{{ field.PropertyName }},
{{~ end ~}}
{{~ end ~}}
            }),
            pageNum,
            pageSize,
            cancellationToken).ConfigureAwait(false);
    }

    /// <summary>
    /// {{ businessName }}表单
    /// </summary>
    public async Task<{{ entityName }}Form> GetFormAsync(long id, CancellationToken cancellationToken = default)
    {
        var q = _readDb.Query<{{ entityName }}>()
            .Where(x => x.Id == id{{ if hasIsDeleted }}{{ if isDeletedType == "bool" }} && x.IsDeleted == false{{ else }} && x.IsDeleted == 0{{ end }}{{ end }});

        var entity = await _readDb.FirstOrDefaultAsync(q, cancellationToken).ConfigureAwait(false);

        if (entity is null)
        {
            throw new BusinessException(ResultCode.InvalidUserInput, "{{ businessName }}不存在");
        }

        return new {{ entityName }}Form
        {
{{~ if hasId ~}}
            Id = entity.Id,
{{~ end ~}}
{{~ for field in fieldConfigs ~}}
{{~ if field.IsShowInForm == 1 && field.FieldName != "id" ~}}
            {{ field.PropertyName }} = entity.{{ field.PropertyName }},
{{~ end ~}}
{{~ end ~}}
        };
    }

    /// <summary>
    /// 新增{{ businessName }}
    /// </summary>
    public async Task<bool> CreateAsync({{ entityName }}Form formData, CancellationToken cancellationToken = default)
    {
        var entity = new {{ entityName }}
        {
{{~ for field in fieldConfigs ~}}
{{~ if field.IsShowInForm == 1 && field.FieldName != "id" ~}}
            {{ field.PropertyName }} = formData.{{ field.PropertyName }},
{{~ end ~}}
{{~ end ~}}
{{~ if hasCreateTime ~}}
            CreateTime = DateTime.Now,
{{~ end ~}}
{{~ if hasUpdateTime ~}}
            UpdateTime = DateTime.Now,
{{~ end ~}}
{{~ if hasCreateBy ~}}
            CreateBy = _currentUser.UserId,
{{~ end ~}}
{{~ if hasUpdateBy ~}}
            UpdateBy = _currentUser.UserId,
{{~ end ~}}
{{~ if hasIsDeleted ~}}
            IsDeleted = {{ if isDeletedType == "bool" }}false{{ else }}0{{ end }},
{{~ end ~}}
        };

        _repository.Add(entity);
        return await _unitOfWork.SaveChangesAsync(cancellationToken).ConfigureAwait(false) > 0;
    }

    /// <summary>
    /// 更新{{ businessName }}
    /// </summary>
    public async Task<bool> UpdateAsync(long id, {{ entityName }}Form formData, CancellationToken cancellationToken = default)
    {
        var entity = await _repository.FindByIdAsync(id, cancellationToken).ConfigureAwait(false);

{{~ if hasIsDeleted ~}}
        if (entity is null || {{ if isDeletedType == "bool" }}entity.IsDeleted == true{{ else }}entity.IsDeleted != 0{{ end }})
{{~ else ~}}
        if (entity is null)
{{~ end ~}}
        {
            throw new BusinessException(ResultCode.InvalidUserInput, "{{ businessName }}不存在");
        }

{{~ for field in fieldConfigs ~}}
{{~ if field.IsShowInForm == 1 && field.FieldName != "id" ~}}
        entity.{{ field.PropertyName }} = formData.{{ field.PropertyName }};
{{~ end ~}}
{{~ end ~}}
{{~ if hasUpdateTime ~}}
        entity.UpdateTime = DateTime.Now;
{{~ end ~}}
{{~ if hasUpdateBy ~}}
        entity.UpdateBy = _currentUser.UserId;
{{~ end ~}}

        _repository.Update(entity);
        await _unitOfWork.SaveChangesAsync(cancellationToken).ConfigureAwait(false);
        return true;
    }

    /// <summary>
    /// 删除{{ businessName }}
    /// </summary>
    public async Task<bool> DeleteAsync(string ids, CancellationToken cancellationToken = default)
    {
        var idList = IdCollectionExtensions.ParsePositiveLongIds(ids);
        if (idList.Count == 0)
        {
            throw new BusinessException(ResultCode.InvalidUserInput, "请选择要删除的{{ businessName }}");
        }

{{~ if hasIsDeleted ~}}
        await _repository.BatchUpdateAsync(
            x => idList.Contains(x.Id) && x.IsDeleted == {{ if isDeletedType == "bool" }}false{{ else }}0{{ end }},
            x =>
            {
                x.IsDeleted = {{ if isDeletedType == "bool" }}true{{ else }}1{{ end }};
{{~ if hasUpdateTime ~}}
                x.UpdateTime = DateTime.Now;
{{~ end ~}}
{{~ if hasUpdateBy ~}}
                x.UpdateBy = _currentUser.UserId;
{{~ end ~}}
            },
            cancellationToken).ConfigureAwait(false);
{{~ else ~}}
        var list = await _repository.ListAsync(x => idList.Contains(x.Id), cancellationToken).ConfigureAwait(false);
        if (list.Count > 0)
        {
            _repository.RemoveRange(list);
            await _unitOfWork.SaveChangesAsync(cancellationToken).ConfigureAwait(false);
        }
{{~ end ~}}

        return true;
    }
}
